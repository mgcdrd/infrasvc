# {{ ansible_managed }}
[Unit]
Description=Keycloak Identity and Access Management
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User={{ keycloak_service_user }}
Group={{ keycloak_service_group }}
WorkingDirectory={{ keycloak_install_dir }}
EnvironmentFile=-/etc/keycloak/keycloak.env
ExecStart={{ keycloak_install_dir }}/bin/kc.sh start --optimized
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
LimitNOFILE=65536
{% if keycloak_systemd_hardening %}

# --- sandboxing ---
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ keycloak_install_dir }}/data
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0027
{% endif %}

[Install]
WantedBy=multi-user.target
